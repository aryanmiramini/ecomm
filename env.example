DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ecommerce_db?schema=public
DB_PASSWORD=YOUR_DB_PASSWORD

NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_PATH=api/docs

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=1h

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_VERIFY_TEMPLATE=

FRONTEND_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3000/api

ORDER_TAX_RATE=0.09
ORDER_SHIPPING_FLAT=50000
ORDER_FREE_SHIPPING_THRESHOLD=500000

MAX_FILE_SIZE=5242880
MEDIA_PATH=./media
RUN_SEED=false

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=09123456789
SUPER_ADMIN_PASSWORD=ChangeThisToAStrongPassword
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

STORE_FOUNDED_YEAR=2018

# Docker images — use Arvan mirror if Docker Hub is blocked (403 / DNS errors)
NODE_IMAGE=docker.arvancloud.ir/library/node:20-alpine
POSTGRES_IMAGE=docker.arvancloud.ir/library/postgres:16-alpine
