DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ecommerce_db?schema=public
DB_PASSWORD=YOUR_DB_PASSWORD

NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_PATH=api/docs

# Required — must be at least 32 random characters and identical in backend + frontend
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=1h

# Cookie secure flag — set true only when serving over HTTPS
COOKIE_SECURE=false

# Auth feature flags (MVP defaults: email/password only)
ENABLE_OTP=false
ENABLE_PASSWORD_RESET=false
NEXT_PUBLIC_ENABLE_OTP=false
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=false

# OTP via Kavenegar (required when ENABLE_OTP=true)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_VERIFY_TEMPLATE=

# Public URLs — use nginx entrypoint in Docker (port 80)
FRONTEND_PUBLIC_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost
HTTP_PORT=80

NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_BACKEND_URL=http://localhost
BACKEND_API_URL=http://localhost:3000/api

ORDER_TAX_RATE=0.09
ORDER_SHIPPING_FLAT=50000
ORDER_FREE_SHIPPING_THRESHOLD=500000
NEXT_PUBLIC_ORDER_TAX_RATE=0.09
NEXT_PUBLIC_ORDER_SHIPPING_FLAT=50000
NEXT_PUBLIC_ORDER_FREE_SHIPPING_THRESHOLD=500000

# Store contact + bank transfer (shown in footer / payment page)
NEXT_PUBLIC_STORE_PHONE=021-00000000
NEXT_PUBLIC_STORE_EMAIL=support@example.com
NEXT_PUBLIC_STORE_ADDRESS=تهران
NEXT_PUBLIC_BANK_CARD_NUMBER=
NEXT_PUBLIC_BANK_SHEBA=
NEXT_PUBLIC_BANK_HOLDER=

MAX_FILE_SIZE=5242880
MEDIA_PATH=./media
RUN_SEED=false

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=09123456789
SUPER_ADMIN_PASSWORD=ChangeThisToAStrongPassword
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

STORE_FOUNDED_YEAR=2018

# Docker images — use Arvan mirror if Docker Hub is blocked (403 / DNS errors)
NODE_IMAGE=docker.arvancloud.ir/library/node:20-alpine
POSTGRES_IMAGE=docker.arvancloud.ir/library/postgres:16-alpine
NGINX_IMAGE=docker.arvancloud.ir/library/nginx:1.27-alpine
